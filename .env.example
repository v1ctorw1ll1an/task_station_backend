# ─── Database ────────────────────────────────────────────────────────────────
# Em produção: fornecido pelo serviço PostgreSQL do Dokploy
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
# Tamanho máximo do pool de conexões da app (pg.PoolConfig.max). Default 10.
DATABASE_POOL_MAX=10

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-use-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# ─── Superuser seed ──────────────────────────────────────────────────────────
SEED_SUPERUSER_EMAIL="admin@example.com"
SEED_SUPERUSER_PASSWORD="change-me"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
MAILER_FROM="TaskDY <noreply@seudominio.com>"
# URL pública do frontend (usada nos links de email)
FRONTEND_URL="http://localhost:3000"
PASSWORD_RESET_EXPIRES_IN=3600

# ─── Attachments ─────────────────────────────────────────────────────────────
# Janitor diário (03:00) faz hard-delete de TaskAttachment soft-deleted há mais
# de N dias e remove arquivos órfãos do disco.
ATTACHMENT_RETENTION_DAYS=30

# ─── Cobrança (Asaas) ────────────────────────────────────────────────────────
# Liga o módulo de cobrança. Com "false": gate de escrita desligado, cron no-op
# e endpoints de cobrança respondem 503 (dev/CI sem chaves).
BILLING_ENABLED="false"
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY="$aact_..."
# Token validado no header `asaas-access-token` de cada webhook (configurar igual no painel Asaas)
ASAAS_WEBHOOK_TOKEN="change-me-webhook-token"
# Grupo de clientes no painel do Asaas — separa os clientes do TaskDY dos outros
# produtos que faturam na MESMA conta. Só afeta o painel: o Asaas não devolve o grupo
# em GET nenhum nem no webhook, então ele nunca identifica o dono de um evento — quem
# faz isso é o namespace do `externalReference`, que é CONSTANTE no código
# (`asaas-identity.ts`) e não se troca sem orfanar tudo que já está gravado lá.
# Ausente = "taskdy". Vazio = cliente sem grupo.
ASAAS_CUSTOMER_GROUP="taskdy"
# Juros a.m. repassados ao cliente no parcelado (anual e compra de assento).
# ZERO desde 31/07/2026: parcelar em 12× custa o mesmo que pagar à vista (R36/R45) —
# a taxa de parcelamento do Asaas é absorvida pela casa. Existe para a política poder
# mudar sem deploy; > 0 volta a encarecer o parcelado para o cliente.
BILLING_ANNUAL_INTEREST_MONTHLY="0"
# Alertas operacionais de cobrança (fila de webhook parada, pagamento sem cobrança,
# estorno). Lista separada por vírgula; vazio = só métrica/log. Ver docs/cobranca-auditoria.md.
BILLING_ALERT_EMAIL=""
# Retenção: empresa cancelada tem os dados excluídos 90 dias depois (avisos em D-30/D-7).
# Desligada por padrão — exclusão não tem desfazer. Ligue o DRY_RUN primeiro para ver
# o que seria apagado antes de valer de verdade.
BILLING_RETENTION_ENABLED="false"
BILLING_RETENTION_DRY_RUN="true"
# Horas sem receber webhook do Asaas antes de alarmar (a fila dele é interrompida
# após 15 falhas e os eventos expiram em 14 dias). Default 12.
BILLING_WEBHOOK_SILENCE_HOURS="12"

# ─── Auto-cadastro (self-service) ────────────────────────────────────────────
# Libera o cadastro público de empresa (POST /auth/register) e o de colaborador
# sem empresa (POST /auth/register-colaborador). Com "false" ambos respondem 404.
# O trial de 7 dias só trava de fato com BILLING_ENABLED="true".
PUBLIC_SIGNUP_ENABLED="false"

# ─── Convites de empresa ─────────────────────────────────────────────────────
# Validade do link de convite para entrar numa empresa existente. Default 7.
COMPANY_INVITE_EXPIRES_DAYS="7"

# ─── Logging ─────────────────────────────────────────────────────────────────
# Opções: debug | info | warn | error
# Use "debug" em development, "info" em production
LOG_LEVEL="debug"

# ─── Docker Compose (apenas dev local) ───────────────────────────────────────
POSTGRES_USER=task_station
POSTGRES_PASSWORD=task_station
POSTGRES_DB=task_station_dev
POSTGRES_PORT=5432
