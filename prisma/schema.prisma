generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  superuser
  admin
  workspace_admin
  project_admin
  member

  @@map("membership_role")
}

enum ResourceType {
  company
  workspace
  project

  @@map("resource_type")
}

enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

enum TokenType {
  password_reset
  first_access

  @@map("token_type")
}

enum NotificationType {
  ADMIN_BROADCAST
  MENTION
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_UPDATED
  EVENT_REMINDER

  @@map("notification_type")
}

enum StickyNoteColor {
  yellow
  blue
  green
  pink
  purple
  gray

  @@map("sticky_note_color")
}

enum EventVisibility {
  private
  shared

  @@map("event_visibility")
}

enum AttendeeStatus {
  invited
  accepted
  declined
  tentative

  @@map("attendee_status")
}

enum ReminderMethod {
  notification
  email

  @@map("reminder_method")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String
  phone             String?
  photoUrl          String?   @map("photo_url")
  isSuperuser       Boolean   @default(false) @map("is_superuser")
  mustResetPassword Boolean   @default(true) @map("must_reset_password")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  createdCompanies    Company[]               @relation("CompanyCreatedBy")
  createdWorkspaces   Workspace[]             @relation("WorkspaceCreatedBy")
  createdProjects     Project[]               @relation("ProjectCreatedBy")
  reportedTasks       Task[]                  @relation("TaskReporter")
  taskAssignments     TaskAssignee[]
  createdTasks        Task[]                  @relation("TaskCreatedBy")
  taskSessions        TaskSession[]
  memberships         Membership[]
  projectRestrictions ProjectRestriction[]
  passwordResetTokens PasswordResetToken[]
  taskHistories       TaskHistory[]
  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  notifications       Notification[]          @relation("UserNotifications")
  triggeredNotifs     Notification[]          @relation("NotificationActors")
  notifPreference     NotificationPreference?
  workspaceOrders     UserWorkspaceOrder[]
  projectOrders       UserProjectOrder[]
  taskChecklists      TaskChecklist[]
  stickyNotes         StickyNote[]
  ownedEvents         CalendarEvent[]         @relation("CalendarEventOwner")
  eventAttendees      CalendarEventAttendee[]
  invitedTaskGuests   TaskGuest[]             @relation("TaskGuestInvitedBy")

  @@index([deletedAt])
  @@map("users")
}

model Company {
  id          String    @id @default(uuid())
  legalName   String    @map("legal_name")
  taxId       String    @unique @map("tax_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy      User            @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  workspaces     Workspace[]
  calendarEvents CalendarEvent[]

  @@map("companies")
}

model Workspace {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company         Company              @relation(fields: [companyId], references: [id])
  createdBy       User                 @relation("WorkspaceCreatedBy", fields: [createdById], references: [id])
  projects        Project[]
  workspaceOrders UserWorkspaceOrder[]
  projectOrders   UserProjectOrder[]
  calendarEvents  CalendarEvent[]

  @@index([companyId])
  @@map("workspaces")
}

model Project {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  icon        String?   @map("icon")
  iconColor   String?   @map("icon_color")
  taskCounter Int       @default(0) @map("task_counter")
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id])
  createdBy           User                 @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  columns             Column[]
  tasks               Task[]
  labels              Label[]
  projectRestrictions ProjectRestriction[]
  notifications       Notification[]
  projectOrders       UserProjectOrder[]

  @@index([workspaceId])
  @@map("projects")
}

model Column {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  name      String
  order     Int
  color     String?
  isDone    Boolean   @default(false) @map("is_done")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]

  @@index([projectId, order])
  @@map("columns")
}

model Task {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  columnId    String       @map("column_id")
  taskNumber  Int?         @map("task_number")
  title       String
  description String?
  priority    TaskPriority @default(medium)
  order       Int
  reporterId  String       @map("reporter_id")
  startDate   DateTime?    @map("start_date") @db.Date
  dueDate     DateTime?    @map("due_date") @db.Date
  createdById String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  project         Project              @relation(fields: [projectId], references: [id])
  column          Column               @relation(fields: [columnId], references: [id])
  reporter        User                 @relation("TaskReporter", fields: [reporterId], references: [id])
  createdBy       User                 @relation("TaskCreatedBy", fields: [createdById], references: [id])
  taskLabels      TaskLabel[]
  taskAssignees   TaskAssignee[]
  taskHistory     TaskHistory[]
  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]
  taskChecklists  TaskChecklist[]
  notifications   Notification[]
  taskSessions    TaskSession[]
  stickyNoteLinks StickyNoteTaskLink[]
  calendarEvents  CalendarEvent[]
  taskGuests      TaskGuest[]

  @@unique([projectId, taskNumber])
  @@index([columnId, order])
  @@index([projectId, deletedAt])
  @@index([reporterId])
  @@index([dueDate])
  @@map("tasks")
}

model Label {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  name      String
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  project    Project     @relation(fields: [projectId], references: [id])
  taskLabels TaskLabel[]

  @@unique([name, projectId])
  @@index([projectId])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskAssignee {
  taskId String @map("task_id")
  userId String @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@map("task_assignees")
}

model Membership {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  resourceType ResourceType   @map("resource_type")
  resourceId   String         @map("resource_id")
  role         MembershipRole
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@map("memberships")
}

model ProjectRestriction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_restrictions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  type      TokenType @default(password_reset) @map("type")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String?  @map("user_id")
  guestId   String?  @map("guest_id")
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at")

  task  Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest TaskGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([changedAt])
  @@map("task_history")
}

model TaskComment {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, deletedAt])
  @@map("task_comments")
}

model TaskAttachment {
  id           String    @id @default(uuid())
  taskId       String    @map("task_id")
  uploadedById String    @map("uploaded_by")
  originalName String    @map("original_name")
  storedName   String    @map("stored_name")
  mimeType     String    @map("mime_type")
  size         Int
  hasThumbnail Boolean   @default(false) @map("has_thumbnail")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId, deletedAt])
  @@map("task_attachments")
}

model TaskChecklist {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  title       String
  completed   Boolean   @default(false)
  order       Int
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([taskId, deletedAt])
  @@map("task_checklists")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  taskId      String?          @map("task_id")
  projectId   String?          @map("project_id")
  actorId     String?          @map("actor_id")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  deletedAt   DateTime?        @map("deleted_at")

  recipient User     @relation("UserNotifications", fields: [recipientId], references: [id])
  actor     User?    @relation("NotificationActors", fields: [actorId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  adminBroadcast        Boolean  @default(true) @map("admin_broadcast")
  mention               Boolean  @default(true)
  taskAssigned          Boolean  @default(true) @map("task_assigned")
  taskComment           Boolean  @default(true) @map("task_comment")
  taskUpdated           Boolean  @default(true) @map("task_updated")
  eventReminder         Boolean  @default(true) @map("event_reminder")
  eventReminderSound    Boolean  @default(true) @map("event_reminder_sound")
  eventReminderPopup    Boolean  @default(true) @map("event_reminder_popup")
  eventReminderBrowser  Boolean  @default(true) @map("event_reminder_browser")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model UserWorkspaceOrder {
  userId      String @map("user_id")
  companyId   String @map("company_id")
  workspaceId String @map("workspace_id")
  position    Int

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
  @@index([userId, companyId])
  @@map("user_workspace_orders")
}

model TaskSession {
  id           String    @id @default(uuid())
  taskId       String    @map("task_id")
  userId       String    @map("user_id")
  status       String // "running" | "paused" | "stopped"
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  resumedAt    DateTime? @map("resumed_at") @db.Timestamptz
  pausedAt     DateTime? @map("paused_at") @db.Timestamptz
  stoppedAt    DateTime? @map("stopped_at") @db.Timestamptz
  totalSeconds Int       @default(0) @map("total_seconds")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, status])
  @@map("task_sessions")
}

model UserProjectOrder {
  userId      String @map("user_id")
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")
  position    Int

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id])

  @@id([userId, projectId])
  @@index([userId, workspaceId])
  @@map("user_project_orders")
}

model StickyNote {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  content   String          @default("") @db.VarChar(255)
  color     StickyNoteColor @default(yellow)
  x         Int             @default(0)
  y         Int             @default(0)
  visible   Boolean         @default(true)
  minimized Boolean         @default(false)
  zIndex    Int             @default(1000) @map("z_index")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskLinks StickyNoteTaskLink[]

  @@index([userId, deletedAt])
  @@map("sticky_notes")
}

model StickyNoteTaskLink {
  noteId String @map("note_id")
  taskId String @map("task_id")

  note StickyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  task Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([noteId, taskId])
  @@index([taskId])
  @@map("sticky_note_task_links")
}

model CalendarEvent {
  id              String          @id @default(uuid())
  ownerId         String          @map("owner_id")
  companyId       String?         @map("company_id")
  workspaceId     String?         @map("workspace_id")
  taskId          String?         @map("task_id")
  title           String
  description     String?
  location        String?
  color           String?
  allDay          Boolean         @default(false) @map("all_day")
  startsAt        DateTime        @map("starts_at") @db.Timestamptz
  endsAt          DateTime        @map("ends_at") @db.Timestamptz
  timezone        String          @default("America/Sao_Paulo")
  rrule           String?
  recurrenceEndAt DateTime?       @map("recurrence_end_at") @db.Timestamptz
  visibility      EventVisibility @default(private)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  owner      User                     @relation("CalendarEventOwner", fields: [ownerId], references: [id])
  company    Company?                 @relation(fields: [companyId], references: [id])
  workspace  Workspace?               @relation(fields: [workspaceId], references: [id])
  task       Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  attendees   CalendarEventAttendee[]
  reminders   CalendarEventReminder[]
  exceptions  CalendarEventException[]
  guestEmails CalendarEventGuestEmail[]

  @@index([ownerId, deletedAt])
  @@index([startsAt, deletedAt])
  @@index([workspaceId, deletedAt])
  @@map("calendar_events")
}

model CalendarEventAttendee {
  id        String         @id @default(uuid())
  eventId   String         @map("event_id")
  userId    String         @map("user_id")
  status    AttendeeStatus @default(invited)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("calendar_event_attendees")
}

model CalendarEventReminder {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  minutesBefore Int            @map("minutes_before")
  method        ReminderMethod @default(email)

  event CalendarEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sent  CalendarEventReminderSent[]

  @@index([eventId])
  @@map("calendar_event_reminders")
}

model CalendarEventGuestEmail {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  @@map("calendar_event_guest_emails")
}

model CalendarEventReminderSent {
  id           String   @id @default(uuid())
  reminderId   String   @map("reminder_id")
  recipientId  String   @map("recipient_id")
  originalDate DateTime @map("original_date") @db.Timestamptz
  sentAt       DateTime @default(now()) @map("sent_at")

  reminder CalendarEventReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, recipientId, originalDate])
  @@map("calendar_event_reminders_sent")
}

model CalendarEventException {
  id                  String    @id @default(uuid())
  eventId             String    @map("event_id")
  originalDate        DateTime  @map("original_date") @db.Timestamptz
  isCancelled         Boolean   @default(false) @map("is_cancelled")
  overrideTitle       String?   @map("override_title")
  overrideDescription String?   @map("override_description")
  overrideStartsAt    DateTime? @map("override_starts_at") @db.Timestamptz
  overrideEndsAt      DateTime? @map("override_ends_at") @db.Timestamptz
  overrideLocation    String?   @map("override_location")
  createdAt           DateTime  @default(now()) @map("created_at")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalDate])
  @@map("calendar_event_exceptions")
}

model TaskGuest {
  id             String    @id @default(uuid())
  taskId         String    @map("task_id")
  name           String
  phoneE164      String    @map("phone_e164")
  email          String?
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by")
  invitedAt      DateTime  @default(now()) @map("invited_at")
  lastAccessedAt DateTime? @map("last_accessed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("TaskGuestInvitedBy", fields: [invitedById], references: [id])
  taskHistory TaskHistory[]

  @@index([taskId, deletedAt])
  @@index([tokenHash])
  @@map("task_guests")
}
